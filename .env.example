# Copy to `.env` and fill in. `.env` is git-ignored.
#
# Both values below are public by design — they already ship in the CRM's
# browser bundle, and `EXPO_PUBLIC_`-prefixed vars are embedded in the app
# binary. NEVER put the Supabase service-role key, the DVLA key, or the
# HaynesPro credentials in this file: anything here is readable by anyone who
# downloads the app. Those live server-side in the CRM only.

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → `anon` public key (NOT `service_role`)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the CRM deployment hosting /api/mobile/* (phase 1).
# Local dev against the CRM: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=

# Google Maps key for the Android en-route map (iOS uses Apple Maps). Not
# EXPO_PUBLIC_: app.config.ts reads it at build time and writes it into the
# Android manifest. Restrict it in Google Cloud to "Maps SDK for Android", the
# package `uk.co.thedigicraft.bmt.mechanic` and the SHA-1s from
# `eas credentials -p android`. For EAS cloud builds set it as an EAS
# environment variable instead. Empty = the map is grey on Android.
GOOGLE_MAPS_ANDROID_API_KEY=
